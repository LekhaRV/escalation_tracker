# Application
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True
API_VERSION=v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tarento_complaints
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_32_PLUS_CHARS_STRING_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI
GEMINI_API_KEY=your_google_gemini_api_key_from_ai_studio
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=2048

# Email IMAP (for ingesting complaints)
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USERNAME=complaints@tarento.com
EMAIL_PASSWORD=gmail_app_specific_password
EMAIL_USE_TLS=True

# SMTP (for sending notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@tarento.com
SMTP_PASSWORD=smtp_app_password
SMTP_FROM_EMAIL=noreply@tarento.com
SMTP_FROM_NAME=Tarento Complaint System

# SLA Thresholds (in hours)
SLA_CRITICAL=4
SLA_HIGH=24
SLA_MEDIUM=72
SLA_LOW=168

# Agent Schedules (cron format)
AGENT_EMAIL_PARSER_SCHEDULE=*/5 * * * *
AGENT_CATEGORIZATION_SCHEDULE=*/2 * * * *
AGENT_MAPPING_SCHEDULE=*/3 * * * *
AGENT_ESCALATION_SCHEDULE=0 * * * *
AGENT_PATTERN_SCHEDULE=0 2 * * *
AGENT_INSIGHT_SCHEDULE=0 3 * * 0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
